# Uygulama
APP_NAME="Employee Management System"
APP_DESCRIPTION="Personel izin ve fazla mesai taleplerinin yönetildiği REST API."
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Sunucu
HOST=0.0.0.0
PORT=8000

# Veritabanı
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_management

# JWT
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS (virgülle ayrılmış origin listesi)
CORS_ORIGINS=http://localhost:5173
