# Uygulama
APP_NAME="Employee Management System"
APP_DESCRIPTION="Personel izin ve fazla mesai taleplerinin yönetildiği REST API."
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Sunucu
HOST=0.0.0.0
PORT=8000

# Veritabanı (PostgreSQL)
# Format: postgresql+psycopg2://<kullanici>:<sifre>@<host>:<port>/<veritabani>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/employee_management

# JWT (Production ortamında en az 32 karakterlik güvenli bir anahtar kullanın)
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS (virgülle ayrılmış origin listesi)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
